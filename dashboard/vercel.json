{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "env": [
    {
      "name": "VITE_API_URL",
      "value": "https://api.hybridlink.share"
    }
  ],
  "build": {
    "env": [
      "VITE_API_URL"
    ]
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}